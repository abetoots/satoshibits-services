{
  "name": "@satoshibits/observability",
  "version": "1.3.0",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    },
    "./node": {
      "import": "./dist/node.mjs",
      "types": "./dist/node.d.mts"
    },
    "./testing": {
      "import": "./dist/testing.mjs",
      "types": "./dist/testing.d.mts"
    },
    "./preset": {
      "import": "./dist/preset.mjs",
      "types": "./dist/preset.d.mts"
    },
    "./register": {
      "import": "./dist/register.mjs",
      "types": "./dist/register.d.mts"
    }
  },
  "type": "module",
  "private": false,
  "scripts": {
    "build": "rm -rf dist && tsc",
    "lint": "pnpm exec eslint .",
    "prepublishOnly": "npm run build",
    "pre-commit": "pnpm exec lint-staged -c ./.lintstagedrc.mjs --concurrent false",
    "capture:attribute-keys": "esbuild src/__tests__/preset/capture-attribute-keys.mts --bundle --packages=external --platform=node --format=esm --log-level=warning --outfile=node_modules/.cache/capture-attribute-keys.mjs && node node_modules/.cache/capture-attribute-keys.mjs ../redaction/src/fixtures/attribute-keys.json",
    "test": "vitest --run",
    "test:shared": "vitest --run --project=shared",
    "test:node:unit": "vitest --run --project=node:unit",
    "test:node:integration": "vitest --run --project=node:integration"
  },
  "files": [
    "dist/**/*",
    "COMPATIBILITY.md",
    "!dist/**/*.test.*",
    "!dist/__tests__/**",
    "!dist/__consumer__/**"
  ],
  "keywords": [
    "opentelemetry",
    "observability",
    "metrics",
    "traces",
    "logs",
    "telemetry",
    "monitoring"
  ],
  "engines": {
    "node": "^18.19.0 || >=20.6.0"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.223.0",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-logs-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-metrics-otlp-proto": "^0.223.0",
    "@opentelemetry/exporter-prometheus": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/exporter-trace-otlp-proto": "^0.223.0",
    "@opentelemetry/instrumentation": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-logs": "^0.223.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@opentelemetry/sdk-trace-node": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@satoshibits/functional-errors": "workspace:*",
    "@satoshibits/redaction": "workspace:*",
    "lru-cache": "^11.3.5"
  },
  "author": {
    "name": "Abe M. Caymo",
    "email": "caymo.abesuni@gmail.com",
    "url": "https://github.com/abetoots"
  },
  "license": "ISC",
  "description": "Unified smart observability client built on OpenTelemetry SDK with automatic instrumentation and business context enrichment",
  "devDependencies": {
    "@eslint/compat": "^1.3.2",
    "@opentelemetry/winston-transport": "^0.33.0",
    "@repo/typescript-config": "workspace:^",
    "@satoshibits/eslint-config": "workspace:^",
    "@types/node": "^24.3.0",
    "@typescript-eslint/utils": "^8.41.0",
    "@vitest/coverage-v8": "^3.2.4",
    "bunyan": "^1.8.15",
    "esbuild": "^0.25.3",
    "eslint": "^9.34.0",
    "express": "^5.1.0",
    "jiti": "^2.5.1",
    "lint-staged": "^16.1.5",
    "pino": "~9.14.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "winston": "^3.19.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abetoots/satoshibits-services.git"
  },
  "homepage": "https://github.com/abetoots/satoshibits-services/packages/observability"
}
