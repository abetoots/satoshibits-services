{
  "name": "@satoshibits/redaction",
  "version": "1.0.0",
  "main": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.mts"
    }
  },
  "type": "module",
  "private": false,
  "sideEffects": false,
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "lint": "pnpm exec eslint .",
    "prepublishOnly": "npm run build",
    "pre-commit": "pnpm exec lint-staged -c ./.lintstagedrc.mjs --concurrent false",
    "test": "vitest --run"
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "redaction",
    "pii",
    "masking",
    "logging",
    "telemetry",
    "opentelemetry"
  ],
  "author": {
    "name": "Abe M. Caymo",
    "email": "caymo.abesuni@gmail.com",
    "url": "https://github.com/abetoots"
  },
  "license": "ISC",
  "description": "Redaction policies for what a process writes or sends: text masks, key rules, a standard policy for telemetry, and a safe description of an error",
  "devDependencies": {
    "@eslint/compat": "^1.2.0",
    "@repo/typescript-config": "workspace:^",
    "@satoshibits/eslint-config": "workspace:^",
    "@types/node": "^22.7.4",
    "@typescript-eslint/utils": "^8.26.1",
    "eslint": "^9.22.0",
    "jiti": "^2.4.2",
    "lint-staged": "^15.2.10",
    "typescript": "^5.7.3",
    "vitest": "^3.1.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/abetoots/satoshibits-services.git"
  },
  "homepage": "https://github.com/abetoots/satoshibits-services/packages/redaction"
}
